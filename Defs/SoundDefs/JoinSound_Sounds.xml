<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================
       PAWN JOINED SOUND
       Plays when a pawn joins the colony from outside the map.

       Audio file: Sounds/JoinSound/pawn_joined.ogg  (already included)
       To swap the sound, replace pawn_joined.ogg with your own OGG Vorbis file
       and restart RimWorld.
       ============================================================ -->

  <SoundDef>
    <defName>JoinSound_PawnJoined</defName>
    <label>Pawn joined colony</label>

    <!-- MapOnly is correct - it is what 1085 of the vanilla SoundDefs use. (There is
         no "Any" SoundContext; the only other values vanilla uses are WorldOnly and
         PlayerStarter.) A map is always loaded when a colonist joins or a trader
         arrives on the colony map. On the world map the sound is skipped, which is
         expected behaviour. -->
    <context>MapOnly</context>

    <subSounds>
      <li>
        <!-- REQUIRED: this def is played through SoundInfo.OnCamera() in
             SoundHelper.PlayOnCamera(). Without onCamera the subsound is placed in
             world space and attenuated by camera distance instead of playing
             straight to the listener. -->
        <onCamera>True</onCamera>

        <!-- THIS WAS THE BUG. RimWorld's volume scale is NOT 0-1. At 0.9~1.0 the clip
             played roughly 40x quieter than a comparable vanilla notification, i.e.
             effectively inaudible. Vanilla reference points:
                 Message_PositiveEvent  40
                 LetterArrive_Good      41
                 Message_PawnDeath      80
                 TinyBell                9
             38~42 matches a positive-event notification and keeps a little natural
             variation. The joinSoundVolume setting still multiplies on top. -->
        <volumeRange>38~42</volumeRange>

        <!-- Pitch range: 1.0 = no shift. Widen slightly for variety. -->
        <pitchRange>
          <min>0.97</min>
          <max>1.03</max>
        </pitchRange>

        <grains>
          <li Class="AudioGrain_Clip">
            <!-- Path is relative to this mod's Sounds/ folder. No extension. -->
            <clipPath>JoinSound/pawn_joined</clipPath>
          </li>
        </grains>
      </li>
    </subSounds>
  </SoundDef>


  <!-- ============================================================
       TRADER ARRIVED SOUND  (optional feature, off by default)
       Plays when any trader arrives — either orbital (comms console)
       or a walk-in caravan trader.

       HOW TO USE A DIFFERENT CLIP FOR TRADERS:
         Place "trader_arrived.ogg" in Sounds/JoinSound/ and change
         the clipPath below to "JoinSound/trader_arrived".
         By default it reuses the same clip as the join sound.
       ============================================================ -->

  <SoundDef>
    <defName>JoinSound_TraderArrived</defName>
    <label>Trader arrived at colony</label>

    <!-- Same reasoning as JoinSound_PawnJoined above. -->
    <context>MapOnly</context>

    <subSounds>
      <li>
        <!-- Played through SoundInfo.OnCamera() - see the note above. -->
        <onCamera>True</onCamera>

        <!-- Was 0.85~0.95 on a scale where vanilla notifications sit at 20-40, so it
             never audibly played. Kept a little below the join sound so a trader
             arriving is less attention-grabbing than a new colonist. -->
        <volumeRange>28~32</volumeRange>

        <pitchRange>
          <min>0.95</min>
          <max>1.05</max>
        </pitchRange>

        <grains>
          <li Class="AudioGrain_Clip">
            <!-- Change to "JoinSound/trader_arrived" if you want a separate clip -->
            <clipPath>JoinSound/pawn_joined</clipPath>
          </li>
        </grains>
      </li>
    </subSounds>
  </SoundDef>

</Defs>
